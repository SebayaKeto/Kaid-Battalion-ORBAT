# Copy this file to ".env" (same folder) and fill in the three Discord values.
# Never share or commit the real .env file.

# Discord Developer Portal > your application > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Developer Portal > your application > Bot > Reset Token
DISCORD_BOT_TOKEN=

# 41st Discord server (already filled in)
DISCORD_GUILD_ID=1563587481214124042

# What counts as "the same connection":
#   strict = exact same IP address (default, safest)
#   subnet = same network block (fewer re-logins on mobile data)
#   off    = never ask again on IP change (not recommended)
ORBAT_IP_MODE=strict

# Discord channels the bot reads logs from, as channelId:training or channelId:operation,
# separated by commas. Default: the training log channel.
ORBAT_LOG_CHANNELS=1563587741445267527:training

# Discord channel the bot posts the audit feed in (approvals, denials, edits
# after review, manual adjustments). Leave empty to turn the feed off.
ORBAT_AUDIT_CHANNEL=
# Channel ID where the bot posts every Assets page change (gains, losses, retractions, new asset types)
ORBAT_ASSETS_CHANNEL=

# Roles added to the private thread the bot opens when a log is denied
# (default: Unit Administration, Unit Leader), separated by commas.
ORBAT_DENIAL_ROLES=1563588894992244757,1563589204099997787

# How many days the Security Log keeps sign-ins, IP addresses and browsers.
# Older entries are deleted every night. 0 keeps them forever (not recommended).
ORBAT_SECURITY_LOG_DAYS=90

# Where the bot finds the site
ORBAT_URL=http://127.0.0.1:8090

# Shared secret between the site and the bot. start-orbat.ps1 fills this in for you.
ORBAT_BOT_SECRET=
